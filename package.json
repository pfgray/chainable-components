{
  "name": "chainable-components",
  "version": "2.0.0",
  "description": "",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "author": {
    "name": "Paul Gray",
    "email": "pfbgray@gmail.com",
    "url": "https://paulgray.net/"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts' --fix",
    "docs:gitbook": "gitbook build ./ docs",
    "docs:typedoc": "typedoc --module commonjs --out docs/typedoc/ src/",
    "build": "npm-run-all clean build:lib build:demo",
    "build:lib": "tsup",
    "build:demo": "TS_NODE_PROJECT=tsconfig.webpack.json webpack --config demo/webpack/bundle.ts",
    "clean": "rm -rf dist/",
    "start": "TS_NODE_PROJECT=tsconfig.webpack.json webpack serve --config demo/webpack/hot.ts",
    "test": "npm-run-all build:lib test:lint test:unit",
    "test:circle": "npm-run-all build:lib test:lint test:unit:circle",
    "test:lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "test:unit": "mocha",
    "test:unit:circle": "mocha --reporter mocha-junit-reporter",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib",
    "version": "git add -A docs/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.0.1",
    "@types/html-webpack-plugin": "^3.2.9",
    "@types/mocha": "^10.0.9",
    "@types/ramda": "^0.25.36",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "^4.0.24",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "chai": "^5.1.2",
    "css-loader": "^7.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "formik": "^0.11.11",
    "history": "^4.7.2",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^25.0.1",
    "jsdom-global": "^3.0.2",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "npm-run-all": "^4.1.5",
    "ramda": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^4.2.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "typedoc": "^0.11.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "fp-ts": "^2.16.9"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "keywords": []
}
